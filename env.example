# 服务器配置
SERVER_ADDR=127.0.0.1:8080
SERVER_PORT=8080

# 内容模式：github（默认）或 local
CONTENT_MODE=github
CONTENT_DIR=content

# GitHub 内容源（local 模式不使用这些地址）
CONTENT_INDEX_URL=https://raw.githubusercontent.com/fenger97/blog/master/content/index.json
CONTENT_BASE_URL=https://raw.githubusercontent.com/fenger97/blog/master/content
CONTENT_CACHE_TTL=5m
# 可选：成功读取内容的持久化快照目录，服务用户需要写入权限
CONTENT_CACHE_DIR=
# 规范链接、分享卡片、站点地图和 RSS 使用的公开地址
SITE_URL=https://fenger.xin
# 私有仓库可填写 GitHub token；公开仓库留空
GITHUB_TOKEN=
